---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import { SITE } from '../../site.config';
import { CATEGORIES } from '../../content.config';
import { getPublished, fmt } from '../../lib/articles';

export async function getStaticPaths() {
  const posts = await getPublished();
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry, posts } }));
}
const { entry, posts } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const url = new URL(`/articles/${entry.id}/`, Astro.site).href;
const related = posts.filter((p) => p.id !== entry.id && p.data.category === d.category).slice(0, 3);
const more = related.length ? related : posts.filter((p) => p.id !== entry.id).slice(0, 3);

const jsonld: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org', '@type': 'Article', headline: d.title, description: d.description,
    datePublished: d.publishDate.toISOString(), dateModified: (d.updatedDate ?? d.publishDate).toISOString(),
    author: { '@type': 'Organization', name: SITE.editorial, url: new URL('/about/', Astro.site).href },
    publisher: { '@type': 'Organization', name: SITE.name }, mainEntityOfPage: url, keywords: d.keywords.join(', '),
    citation: d.sources.map((s) => s.url),
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
      { '@type': 'ListItem', position: 2, name: CATEGORIES[d.category], item: new URL(`/category/${d.category}/`, Astro.site).href },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
if (d.faq.length) {
  jsonld.push({
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
---
<Base title={d.title} description={d.description} type="article" jsonld={jsonld}>
  <article class="article">
    <div class="crumbs"><a href="/">Home</a> › <a href={`/category/${d.category}/`}>{CATEGORIES[d.category]}</a></div>
    <a class="pill" href={`/category/${d.category}/`}>{CATEGORIES[d.category]}</a>
    <h1>{d.title}</h1>
    <p class="lede">{d.description}</p>
    <div class="byline">
      By <a href="/about/">{SITE.editorial}</a> · Published {fmt(d.publishDate)}
      {d.updatedDate && <> · Updated {fmt(d.updatedDate)}</>} · {d.readingMinutes} min read
    </div>
    <div class="prose"><Content /></div>

    {d.faq.length > 0 && (
      <section class="faq">
        <h2 class="section-title">Frequently asked questions</h2>
        {d.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </section>
    )}

    <div class="notice"><strong>Medical disclaimer:</strong> This article is for general educational purposes and is not a substitute for professional medical advice, diagnosis or treatment. If you have a health concern, talk to a qualified healthcare provider. <a href="/medical-disclaimer/">Read more</a>.</div>

    <section class="sources">
      <h2 class="section-title">Sources</h2>
      <ol>{d.sources.map((s) => <li><a href={s.url} rel="nofollow noopener" target="_blank">{s.title}</a></li>)}</ol>
    </section>

    {more.length > 0 && (
      <section class="related">
        <h2 class="section-title">Keep reading</h2>
        <div class="grid" style="padding-bottom:0">{more.map((p) => <Card entry={p} />)}</div>
      </section>
    )}
  </article>
</Base>
